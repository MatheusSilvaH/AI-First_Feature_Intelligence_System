# ---------------------------------------------------------------------------
# Copy to .env and fill in. The .env file is git-ignored and is read by the
# SERVER ONLY. The React app never sees these values - every Claude call is
# proxied through the Node backend.
# ---------------------------------------------------------------------------

# Required. Your Anthropic API key (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=sk-ant-...

# Model routing. Two tiers so cheap high-volume work does not pay Opus prices.
# ANTHROPIC_MODEL_PRIMARY   - judgment-heavy stages: scoring, decision briefs,
#                             stakeholder comms, emerging-needs synthesis.
# ANTHROPIC_MODEL_FAST      - high-volume mechanical stages: triage, need
#                             extraction, duplicate adjudication, theming.
ANTHROPIC_MODEL_PRIMARY=claude-opus-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Reasoning effort for the primary model on scoring/brief stages.
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# SQLite database file. Use ":memory:" for ephemeral test runs.
DATABASE_PATH=./data/feature-intelligence.db

# Background AI worker
AI_WORKER_ENABLED=true
AI_WORKER_CONCURRENCY=2
AI_WORKER_POLL_MS=1000
AI_JOB_MAX_ATTEMPTS=3

# Set to true to skip all Claude calls and use a deterministic stub pipeline.
# Useful for UI work, CI, and demos without burning API credits.
AI_DRY_RUN=false

# Public write endpoints: requests per window, per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
